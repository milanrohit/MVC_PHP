APP_NAME="MVC_PHP_ECOMMERCE"
APP_ENV=local
APP_DEBUG=true
# Leave empty to auto-detect (works for XAMPP subfolders and Docker root)
APP_BASE_PATH=

# --- Database ---
# Docker : DB_HOST=db   DB_PORT=3306
# XAMPP  : DB_HOST=127.0.0.1  DB_PORT=3306
# Leave DB_HOST empty to auto-detect (Docker -> db, otherwise 127.0.0.1)
DB_HOST=
DB_PORT=3306
DB_DATABASE=mvc_app
DB_USERNAME=root
DB_PASSWORD=

# --- Docker only (host-side published ports; avoid clash with XAMPP 80/3306) ---
APP_PORT=8080
DB_FORWARD_PORT=3307
PMA_PORT=8081
DB_ROOT_PASSWORD=secret
