<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="MVC_PHP_Standards"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">

    <description>PHP 8.6 standard: PSR-12 base, modern syntax, SOLID guardrails, security rules.</description>

    <!-- ===== 1. Scope ===== -->
    <file>app</file>
    <file>config</file>
    <file>core</file>
    <file>database</file>
    <file>routes</file>
    <file>public/index.php</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/storage/*</exclude-pattern>
    <exclude-pattern>*/cache/*</exclude-pattern>
    <rule ref="Internal.NoCodeFound">
        <exclude-pattern>*/Views/*</exclude-pattern>
    </rule>

    <!-- ===== 2. Runtime options (container + CI friendly) ===== -->
    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="encoding" value="utf-8"/>
    <arg name="parallel" value="8"/>
    <!-- One cache location only (a second <arg name="cache"> silently overrides the first). -->
    <arg name="cache" value="/tmp/.phpcs.cache"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <ini name="memory_limit" value="512M"/>

    <!-- Warnings (length, structure, TODOs, complexity "warning" thresholds) are reported
         but do NOT fail CI. Only errors fail the build.
         Remove this line once the warning backlog is cleared to make warnings blocking too. -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <!-- ===== 3. PHP version compatibility =====
         Disabled: phpcompatibility/php-compatibility 9.3.5 (2019) predates PHP 8 and reports
         false errors on modern syntax. Re-enable only with a 10.x release that supports 8.x:
           <config name="testVersion" value="8.6-"/>
           <rule ref="PHPCompatibility"/>
    -->

    <!-- ===== 4. Base style: PSR-12 ===== -->
    <rule ref="PSR12"/>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="140"/>
        </properties>
    </rule>

    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>public/index.php</exclude-pattern>
        <exclude-pattern>database/migrate.php</exclude-pattern>
    </rule>

    <!-- ===== 5. Modern PHP: strict types, full typing, PER-style details ===== -->
    <rule ref="SlevomatCodingStandard.TypeHints.DeclareStrictTypes">
        <properties>
            <property name="spacesCountAroundEqualsSign" value="0"/>
            <property name="linesCountBeforeDeclare" value="1"/>
            <property name="linesCountAfterDeclare" value="1"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.ParameterTypeHint">
        <exclude name="SlevomatCodingStandard.TypeHints.ParameterTypeHint.MissingTraversableTypeHintSpecification"/>
        <exclude name="SlevomatCodingStandard.TypeHints.ParameterTypeHint.UselessAnnotation"/>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint">
        <exclude name="SlevomatCodingStandard.TypeHints.ReturnTypeHint.MissingTraversableTypeHintSpecification"/>
        <exclude name="SlevomatCodingStandard.TypeHints.ReturnTypeHint.UselessAnnotation"/>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.PropertyTypeHint">
        <exclude name="SlevomatCodingStandard.TypeHints.PropertyTypeHint.MissingTraversableTypeHintSpecification"/>
        <exclude name="SlevomatCodingStandard.TypeHints.PropertyTypeHint.UselessAnnotation"/>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.NullableTypeForNullDefaultValue"/>
    <rule ref="SlevomatCodingStandard.TypeHints.UselessConstantTypeHint"/>
    <rule ref="SlevomatCodingStandard.TypeHints.DNFTypeHintFormat">
        <properties>
            <property name="enable" value="true"/>
            <property name="withSpacesAroundOperators" value="no"/>
            <property name="withSpacesInsideParentheses" value="no"/>
            <property name="shortNullable" value="yes"/>
            <property name="nullPosition" value="last"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Classes.RequireConstructorPropertyPromotion"/>
    <rule ref="SlevomatCodingStandard.Classes.ClassConstantVisibility"/>
    <rule ref="SlevomatCodingStandard.Classes.ModernClassNameReference"/>
    <rule ref="SlevomatCodingStandard.Classes.RequireSelfReference"/>
    <rule ref="SlevomatCodingStandard.Classes.UselessLateStaticBinding"/>
    <rule ref="SlevomatCodingStandard.Classes.DisallowMultiPropertyDefinition"/>
    <rule ref="SlevomatCodingStandard.Attributes.RequireAttributeAfterDocComment"/>
    <rule ref="SlevomatCodingStandard.ControlStructures.RequireNullCoalesceOperator"/>
    <rule ref="SlevomatCodingStandard.ControlStructures.NewWithParentheses"/>
    <rule ref="SlevomatCodingStandard.Functions.StaticClosure"/>
    <rule ref="SlevomatCodingStandard.Functions.RequireTrailingCommaInCall">
        <properties>
            <property name="enable" value="true"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Functions.RequireTrailingCommaInDeclaration">
        <properties>
            <property name="enable" value="true"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Arrays.TrailingArrayComma"/>
    <rule ref="SlevomatCodingStandard.PHP.TypeCast"/>
    <rule ref="SlevomatCodingStandard.PHP.UselessParentheses"/>
    <rule ref="SlevomatCodingStandard.Namespaces.UseFromSameNamespace"/>
    <rule ref="SlevomatCodingStandard.Namespaces.AlphabeticallySortedUses"/>
    <!-- Performance: \strlen() etc. compile to direct opcodes instead of a runtime lookup -->
    <rule ref="SlevomatCodingStandard.Namespaces.FullyQualifiedGlobalFunctions">
        <properties>
            <property name="includeSpecialFunctions" value="true"/>
        </properties>
    </rule>

    <!-- ===== 6. SOLID guardrails ===== -->
    <rule ref="SlevomatCodingStandard.Classes.ClassLength">
        <properties>
            <property name="maxLinesLength" value="300"/>
        </properties>
        <type>warning</type>
    </rule>
    <rule ref="SlevomatCodingStandard.Functions.FunctionLength">
        <properties>
            <property name="maxLinesLength" value="50"/>
        </properties>
        <type>warning</type>
    </rule>
    <rule ref="SlevomatCodingStandard.Complexity.Cognitive">
        <properties>
            <property name="warningThreshold" value="10"/>
            <property name="errorThreshold" value="15"/>
        </properties>
    </rule>
    <rule ref="Generic.Metrics.CyclomaticComplexity">
        <properties>
            <property name="complexity" value="10"/>
            <property name="absoluteComplexity" value="15"/>
        </properties>
    </rule>
    <rule ref="Generic.Metrics.NestingLevel">
        <properties>
            <property name="nestingLevel" value="3"/>
            <property name="absoluteNestingLevel" value="4"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Classes.ClassStructure">
        <type>warning</type>
    </rule>
    <rule ref="SlevomatCodingStandard.Classes.ClassMemberSpacing"/>
    <rule ref="SlevomatCodingStandard.Classes.RequireAbstractOrFinal">
        <type>warning</type>
    </rule>
    <rule ref="SlevomatCodingStandard.Classes.ForbiddenPublicProperty">
        <properties>
            <property name="allowReadonly" value="true"/>
            <property name="allowNonPublicSet" value="true"/>
            <property name="checkPromoted" value="true"/>
        </properties>
        <type>warning</type>
    </rule>

    <!-- Superglobals allowed ONLY in the request/session wrappers and the front controller.
         The excludes are scoped to this rule; at top level they would skip these files from
         EVERY check (and public/index.php would never be scanned at all). -->
    <rule ref="SlevomatCodingStandard.Variables.DisallowSuperGlobalVariable">
        <exclude-pattern>core/Request.php</exclude-pattern>
        <exclude-pattern>core/Session.php</exclude-pattern>
        <exclude-pattern>public/index.php</exclude-pattern>
    </rule>

    <!-- ===== 7. Clean code (Sonar-style) ===== -->
    <rule ref="SlevomatCodingStandard.Namespaces.UnusedUses"/>
    <rule ref="SlevomatCodingStandard.Variables.UnusedVariable"/>
    <rule ref="SlevomatCodingStandard.ControlStructures.EarlyExit"/>
    <rule ref="SlevomatCodingStandard.Exceptions.ReferenceThrowableOnly"/>
    <rule ref="SlevomatCodingStandard.Exceptions.DeadCatch"/>
    <rule ref="SlevomatCodingStandard.Functions.DisallowEmptyFunction"/>
    <rule ref="SlevomatCodingStandard.Operators.DisallowEqualOperators"/>
    <rule ref="SlevomatCodingStandard.Functions.StrictCall"/>
    <rule ref="Squiz.PHP.CommentedOutCode">
        <properties>
            <property name="maxPercentage" value="30"/>
        </properties>
    </rule>

    <rule ref="Generic.CodeAnalysis.EmptyStatement"/>
    <rule ref="Generic.CodeAnalysis.UnconditionalIfStatement"/>
    <rule ref="Generic.CodeAnalysis.ForLoopWithTestFunctionCall"/>
    <rule ref="Generic.CodeAnalysis.JumbledIncrementer"/>
    <rule ref="Generic.Commenting.Todo"/>

    <!-- ===== 8. Security guardrails ===== -->
    <rule ref="Generic.PHP.NoSilencedErrors">
        <properties>
            <property name="error" value="true"/>
        </properties>
    </rule>
    <rule ref="Squiz.PHP.Eval"/>
    <rule ref="Generic.PHP.BacktickOperator"/>
    <rule ref="Generic.PHP.DeprecatedFunctions"/>

    <rule ref="Generic.PHP.ForbiddenFunctions">
        <properties>
            <property name="forbiddenFunctions" type="array">
                <element key="eval" value="null"/>
                <element key="assert" value="null"/>
                <element key="create_function" value="null"/>
                <element key="extract" value="null"/>
                <element key="parse_str" value="null"/>
                <element key="shell_exec" value="null"/>
                <element key="exec" value="null"/>
                <element key="system" value="null"/>
                <element key="passthru" value="null"/>
                <element key="popen" value="null"/>
                <element key="proc_open" value="null"/>
                <element key="pcntl_exec" value="null"/>
                <element key="unserialize" value="json_decode"/>
                <element key="var_dump" value="null"/>
                <element key="print_r" value="null"/>
                <element key="phpinfo" value="null"/>
                <element key="debug_zval_dump" value="null"/>
                <element key="rand" value="random_int"/>
                <element key="mt_rand" value="random_int"/>
                <element key="srand" value="null"/>
                <element key="mt_srand" value="null"/>
                <element key="uniqid" value="random_bytes"/>
                <element key="lcg_value" value="random_int"/>
                <element key="md5" value="hash"/>
                <element key="sha1" value="hash"/>
                <element key="crypt" value="password_hash"/>
                <element key="mysql_query" value="PDO"/>
                <element key="mysql_connect" value="PDO"/>
                <element key="mysqli_query" value="PDO"/>
            </property>
            <property name="error" value="true"/>
        </properties>
    </rule>

    <!-- ===== 9. File hygiene ===== -->
    <rule ref="Generic.Files.ByteOrderMark"/>
    <rule ref="Generic.Files.LineEndings">
        <properties>
            <property name="eolChar" value="\n"/>
        </properties>
    </rule>
</ruleset>
