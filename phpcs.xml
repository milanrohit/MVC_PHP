<?xml version="1.0"?>
<ruleset name="MVC_PHP_Standards">
    <description>Modern PHP 8.5+ custom coding standards linter config.</description>

    <!-- 1. Enforce the modern PSR-12 coding standard ruleset -->
    <rule ref="PSR12"/>

    <!-- 2. Target your exact project source directories shown in VS Code -->
    <file>app/</file>
    <file>config/</file>
    <file>core/</file>
    <file>database/</file>
    <file>routes/</file>

    <!-- 3. Explicitly exclude compiled vendor and temporary system assets -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/storage/*</exclude-pattern>
    <exclude-pattern>*/public/*</exclude-pattern>

    <!-- 4. Useful runtime options for Git Bash terminals -->
    <arg name="colors"/>
    <arg value="sp"/>
</ruleset>
