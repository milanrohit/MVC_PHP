{
    "name": "ecommerce/my-mvc-project",
    "description": "Lightweight custom PHP MVC framework (zero runtime dependencies)",
    "type": "project",
    "require": { "php": ">=8.2", "ext-pdo": "*" },
    "autoload": {
        "psr-4": { "App\\": "app/", "Core\\": "core/" },
        "files": ["core/helpers.php"]
    },
    "config": { "optimize-autoloader": true, "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        } },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "*",
        "phpcompatibility/php-compatibility": "*",
        "slevomat/coding-standard": "*",
        "squizlabs/php_codesniffer": "^3.13"
    }
}
