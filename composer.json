{
    "name": "ecommerce/my-mvc-project",
    "description": "Lightweight custom PHP MVC framework (zero runtime dependencies)",
    "type": "project",
    "license": "MIT",
    "require": { 
        "php": "^8.6",
        "ext-pdo": "*",
        "ext-mbstring": "*" 
    },
    "autoload": {
        "psr-4": { "App\\": "app/", "Core\\": "core/" },
        "files": ["core/helpers.php"]
    },
    "config": { 
        "platform": { "php": "8.6.0" },
        "optimize-autoloader": true,
        "sort-packages": true,
        "dealerdirect/phpcodesniffer-composer-installer": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        } 
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.9",
        "slevomat/coding-standard": "^8.15",
        "squizlabs/php_codesniffer": "^3.13.0"
    },
    "scripts": {
        "stan": "phpstan analyse src app --level=8",
        "lint": "pint --test",
        "audit": "composer audit --locked",
        "check": [
        "@lint",
        "@stan",
        "@audit"
        ]
    }
}
